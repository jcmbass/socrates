# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm workspaces hoist to the repo-root node_modules, but
# guard nested ones too in case a workspace ever needs its own)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (apps/harness/.next, not repo-root anymore)
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example
!**/.env.example

# eval output
/eval-results/

# ingest cache (content-hashed PDF transcriptions, machine-local)
/.ingest-cache/

# session store (student-text session files, machine-local — alpha, never leaves the founder's machine)
/sessions/

# claude session file (auto-generated by Claude Code)
claude-session

# agent skills instaladas localmente vía `npx skills add` (decisión founder
# 2026-07-17: tooling personal, no se comitea) — .agents/ contiene las
# skills, skills-lock.json es su lockfile, .claude/skills/ son symlinks
/.agents/
/skills-lock.json
/.claude/skills/
/.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# caché local de Expo (se regenera en cada máquina)
.expo/

# índice del MCP de codebase-memory — artefacto de tooling, regenerable,
# machine-local (2.3 MB de grafo indexado, no es fuente)
/.codebase-memory/

# evidencia de QA en device (moto e13): capturas de pantalla de las fases
# M0-M3, verificaciones de craft y builds. ~12 MB de PNG que nunca se
# commitearon — los hallazgos viven en prosa en DEVLOG.md, no en las
# imágenes. Consecuencia asumida: las rutas que DEVLOG.md cita son locales
# de la máquina donde se corrió la verificación.
/harness/device-e13/

# tarball de importación de la maqueta original — 14 MB y trae adentro una
# copia de otro proyecto CON SU PROPIO .git. No pertenece al repo; lo ideal
# es moverlo fuera del árbol de trabajo, esto solo evita que ensucie git.
/assets/socrates.tar

# PDF de 15 MB que reprodujo el bug de rasterizado (beta-real 07). NO se
# versiona: lo que importa del caso son sus DIMENSIONES (1376x768 pt, cero
# texto extraible), y eso ya está fijado en los tests puros de
# apps/server/__tests__/raster/scale.test.ts. Meter 15 MB de binario en la
# historia para siempre no aporta nada que el test no cubra.
/docs/The_Distributed_Node.pdf

# infra/modal (camino alterno, Python fuera del monorepo TS)
.venv/
__pycache__/
*.py[cod]
