# apps/server — C2 backend. Copy to .env for local dev (never commit a real .env).

NODE_ENV=development
BUXO_ENV=dev
PORT=3001

# Postgres (DF-6: managed Postgres — Neon/Fly Postgres/Railway Postgres in
# staging/prod; local Postgres or `docker run postgres` for dev). The test
# suite does NOT use this — it runs against in-memory pglite exclusively.
DATABASE_URL=postgres://buxo:buxo@localhost:5432/buxo

# Bearer session JWTs (DF-6.2, self-hosted auth) — generate a real random
# secret for staging/prod, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-insecure-secret-change-me-32-chars-min
JWT_ISSUER=buxo-server
SESSION_TTL_SECONDS=2592000

# Magic-link auth (DF-6.2). MAGIC_LINK_BASE_URL is the deep link/route the
# client hits to consume a link — defaults to this server's own
# /v1/auth/verify (dev pega-token flow). For the mobile beta (F2 WQ4), point
# this at apps/mobile's expo-router deep link instead so the emailed link
# opens the app directly:
# MAGIC_LINK_BASE_URL=buxo://login
MAGIC_LINK_TTL_MINUTES=20
MAGIC_LINK_BASE_URL=http://localhost:3001/v1/auth/verify

# BE3 — magic-link email transport. Default `console` logs the link (dev /
# pre-Resend). Set `resend` + RESEND_API_KEY on Render for real inboxes.
# Boot fails loud if EMAIL_SENDER=resend without RESEND_API_KEY.
EMAIL_SENDER=console
# RESEND_API_KEY=
# Remitente. Default = free tier de Resend. Objetivo tras verificar cubo.lat:
# EMAIL_FROM=Socrates <no-reply@socrates.cubo.lat>
EMAIL_FROM=Socrates <onboarding@resend.dev>

# Freemium quotas (C-backend §2.5) — starting points from the spec's D3
# estimate, adjustable without a redeploy in a later phase (§6.4 feature
# flags; still env vars for F1).
QUOTA_DAILY_TUTOR_MESSAGES=25
QUOTA_MONTHLY_TUTOR_MESSAGES=175
QUOTA_CAP_COST_USD=4
# F2 WQ1 — Tier-2 (cloud-page) ingest quota, first-pass estimates flagged
# for architect review (see src/env.ts's docblock on these two fields).
QUOTA_DAILY_INGEST_CLOUD_PAGES=20
QUOTA_MONTHLY_INGEST_CLOUD_PAGES=150
# Fraction (0-1) of exchanges the judge evaluates (D3 §7 sampling).
# Dev default 0.2. PROD (dashboard Render, verificado 2026-08-06):
# JUDGE_SAMPLE_RATE=0.1 — el juez SÍ corre sobre ~1 de cada 10 intercambios.
JUDGE_SAMPLE_RATE=0.2

# @buxo/models (C7) chains — "provider:model,provider:model,...". Empty/unset
# falls back to the hardcoded floor (Sonnet 5 for tutor/assessor/judge, Haiku
# 4.5 for ingest/safety) per C-backend §1.3. Only registry rows with
# gateStatus:"validated" can serve traffic outside dev+BUXO_DEV_ALLOW_PENDING_GATE.
# ⚠️ gateStatus puede ser mapa por-tarea (ver packages/models/registry.ts).
# DISEÑO DE DOS MODELOS (2026-08-11): Anthropic sale por completo de la ruta
# del estudiante.
BUXO_TUTOR_CHAIN=deepinfra:google/gemma-4-31B-it
# Assessor de BANDA (DeepSeek, ~4s): corre CADA turno, persiste la banda.
BUXO_ASSESSOR_CHAIN=deepinfra:deepseek-ai/DeepSeek-V4-Flash-0731
# Assessor de MASTERY (Qwen, ~73s): corre MUESTREADO, alimenta mastery/rachas.
BUXO_MASTERY_ASSESSOR_CHAIN=deepinfra:Qwen/Qwen3.6-35B-A3B
# Fracción (0-1) de intercambios con assessor de mastery. Default 1/3 — la
# racha avanza a esta velocidad (cambio de comportamiento, ver guía de flip).
MASTERY_ASSESSOR_SAMPLE_RATE=0.3333
BUXO_JUDGE_CHAIN=deepinfra:Qwen/Qwen3.6-35B-A3B
BUXO_INGEST_CHAIN=deepinfra:Qwen/Qwen3-VL-30B-A3B-Instruct
# Ingesta DeepInfra (Qwen3-VL): gate O-14 aprobado 2026-08-02, en prod. ~6x mas
# barato que Haiku y mejor calidad medida (docs/plan-modal-rag/05-medicion-deepinfra-por-token.md).
BUXO_SAFETY_CHAIN=anthropic:claude-haiku-4-5
# Temario-builder agentico (P2 FIX1): NO tiene piso Sonnet por diseno — si esta
# vacia, `temario:generate` falla ruidoso (ModelChainExhaustedError) en la primera
# invocacion. Debe ser UN solo modelo con toolUse. deepinfra:google/gemma-4-31B-it:
# tool-calling MEDIDO por smoke test real (gate F2, 2026-08-10) — ver registry.
BUXO_TEMARIO_BUILDER_CHAIN=deepinfra:google/gemma-4-31B-it
# Sesión guiada: structured JSON+Zod. DeepSeek-V4-Flash-0731 sigue pending_gate
# para esta tarea (no hay O-14). La cadena sola NO sirve en prod; hace falta el flag
# estrecho BUXO_GUIDED_ITEMS_ALLOW_PENDING_GATE (no uses el global de dev).
BUXO_GUIDED_ITEMS_CHAIN=deepinfra:deepseek-ai/DeepSeek-V4-Flash-0731
# Closed beta: false permite grounding=general si no hay Fuentes. Cambiar a
# true hace fail-close (sesión degradada, cero llamada al modelo).
BUXO_GUIDED_REQUIRE_SOURCES=false
# Closed beta: 1/true/yes sirve la cadena pending. 0/unset = cadena vacía y degradación.
# En Render el valor debe ser exactamente 1, true o yes (sin comillas en el dashboard).
BUXO_GUIDED_ITEMS_ALLOW_PENDING_GATE=true
# Dev-only escape hatch (O-14) — must NEVER be true outside BUXO_ENV=dev.
BUXO_DEV_ALLOW_PENDING_GATE=false

# Beta externa (BE2 decision, 2026-07-18): "sonnet" (default) appendea el piso
# Sonnet a la cadena del tutor como failover. "none" elimina el piso: si el
# modelo configurado falla, la petición falla RUIDOSO en vez de caer a Anthropic.
# Esto protege la directiva del founder: Anthropic solo gasta por el assessor.
# Solo afecta al tutor. Assessor/judge/ingest/safety inalterados.
# BUXO_TUTOR_FAILOVER_FLOOR=none

# Beta externa (BE2 decision, 2026-07-18): selecciona la versión del prompt
# del tutor. "buxo-socratic-v3" (default) es el prompt base gateado.
# "buxo-socratic-v4" activa las reglas endurecidas (hardened) que pasaron
# el gate O-14 del tutor en BE2. El Flip beta DEBE servir v4.
# BUXO_TUTOR_PROMPT_VERSION=buxo-socratic-v4

# Dev-only fake-models mode (F1/WP6 Part 1): "true"/"1" swaps the real
# ProviderResolver for src/models/fake-adapters.ts — canned, chunk-streamed
# Socratic tutor replies + deterministic assessor/judge verdicts, ZERO calls
# to Anthropic/OpenRouter/etc. Boot logs a loud banner when active. MUST
# NEVER be true outside BUXO_ENV=dev — readEnv throws otherwise.
BUXO_FAKE_MODELS=false

# Real model calls (never used by the test suite — tests always inject a
# fake ProviderResolver + mock the "ai" package's streamText/generateObject).
ANTHROPIC_API_KEY=

# Ollama — daemon local (http://localhost:11434/v1, sin apiKey) o cloud directo
# (https://ollama.com/v1, con OLLAMA_API_KEY). El founder pega la key en Render.
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# DeepInfra — OpenAI-compat, apiKey requerida (a diferencia de Ollama local).
# Modelos en uso tras la migración DeepInfra (2026-08-11):
#   - tutor + temario-builder: deepinfra:google/gemma-4-31B-it (validated por-tarea)
#   - ingesta: deepinfra:Qwen/Qwen3-VL-30B-A3B-Instruct (validated, gate O-14)
#   - assessor: NO migró y NO va a migrar por ahora — gemma (60.7%), DeepSeek
#     preview (42.9%) y release -0731 (25.0%) FAILaron la calibración con v3; la
#     rúbrica mecánica v4 se probó a fondo (reportes 07-09) y no alcanzó la
#     concordancia de Sonnet-v3 (89.3%). Se queda en Anthropic; el trade-off
#     calidad-costo es decisión del founder.
# ⚠️ provider.ts pasa supportsStructuredOutputs:true (lever F2) a TODO modelo
# deepinfra — sin eso el SDK degrada a json_object y la reliability cae a 90%.
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_API_KEY=

# B2-motor-de-dominio.md §5.1 — mastery aggregation runs in shadow for the
# whole beta by default; flipping to "visible" is a manual, gated decision
# (§5.3), never a routine deploy-time toggle.
MASTERY_VISIBILITY_MODE=shadow
# B2 §7.2 — JSON array of "providerId/modelId/promptVersion" (each field may
# be "*") naming assessor tripletas approved to feed mastery aggregation.
# Unset/empty = DENY-ALL (PB2 flip, pre-beta): nothing feeds aggregation
# until a tripleta is explicitly approved here after passing its gate.
# Diseño de dos modelos (2026-08-11): SOLO la tripleta de Qwen — es el
# mecanismo que hace cumplir la separación (los veredictos de DeepSeek, banda,
# NO pueden llegar al mastery). Formato arreglado (parser por extremos: el id
# de Qwen lleva slash adentro).
BUXO_ASSESSOR_AGGREGATION_ALLOWLIST=["deepinfra/Qwen/Qwen3.6-35B-A3B/buxo-assessor-v3"]
# ⚠️ TRAMPA #1 de la migración (plan-migracion-deepinfra F3.4): deny-by-default.
# Si el assessor de mastery cambia de proveedor/modelo/prompt y NADIE actualiza
# esta allowlist, la agregación de mastery se apaga EN SILENCIO y las rachas
# dejan de subir. Al flipear: actualizar acá + Render, en el MISMO flip.
